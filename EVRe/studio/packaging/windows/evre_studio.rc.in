// SPDX-License-Identifier: Apache-2.0
// A Windows program's icon (Explorer, the taskbar, the Start menu: the teknile mark, packaging/icons) and its version,
// made by CMake (configure_file, once for EVReStudio.exe, evre.exe and evre-sim.exe) with the icon's full path, the
// project's version and the program's name and description: a signed file must name its product and version
#include <winver.h>

IDI_ICON1 ICON "@EVRE_ICON_FILE@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "teknile"
            VALUE "FileDescription", "@EVRE_RC_DESCRIPTION@"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "@EVRE_RC_NAME@"
            VALUE "LegalCopyright", "Apache License 2.0"
            VALUE "OriginalFilename", "@EVRE_RC_NAME@.exe"
            VALUE "ProductName", "EVRe Studio"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
