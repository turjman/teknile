// SPDX-License-Identifier: Apache-2.0
// EVReStudio.exe's icon (Explorer, the taskbar, the Start menu: the teknile mark, packaging/icons) and its version,
// made by CMake (configure_file) with the icon's full path and the project's version
#include <winver.h>

IDI_ICON1 ICON "@EVRE_ICON_FILE@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "teknile"
            VALUE "FileDescription", "EVRe Studio"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "EVReStudio"
            VALUE "LegalCopyright", "Apache License 2.0"
            VALUE "OriginalFilename", "EVReStudio.exe"
            VALUE "ProductName", "EVRe Studio"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
